{
  "about": "text = \"<appId>-change:2|\" + canonical({v:2, set:dataSet, device, seq, clock, collection, id, kind (redacted counts as set), check, prev (only when the change has one: every change after the first carries the link of its predecessor)}); the content is bound through check, the hash chain through prev. Changed with the hash chain (round 3, third pass): changes with seq above 1 now carry prev; the first change's text is unchanged.",
  "cases": [
    {
      "name": "a set (the first change has no prev)",
      "appId": "demo",
      "dataSet": "main",
      "change": {
        "device": "a",
        "seq": 1,
        "clock": 3,
        "collection": "items",
        "id": "x",
        "kind": "set",
        "check": "c1"
      },
      "text": "demo-change:2|{\"check\":\"c1\",\"clock\":3,\"collection\":\"items\",\"device\":\"a\",\"id\":\"x\",\"kind\":\"set\",\"seq\":1,\"set\":\"main\",\"v\":2}"
    },
    {
      "name": "a delete keeps kind delete and names the link of its predecessor",
      "appId": "demo",
      "dataSet": "main",
      "change": {
        "device": "a",
        "seq": 2,
        "clock": 4,
        "collection": "items",
        "id": "x",
        "kind": "delete",
        "check": "c2",
        "prev": "c1"
      },
      "text": "demo-change:2|{\"check\":\"c2\",\"clock\":4,\"collection\":\"items\",\"device\":\"a\",\"id\":\"x\",\"kind\":\"delete\",\"prev\":\"c1\",\"seq\":2,\"set\":\"main\",\"v\":2}"
    },
    {
      "name": "a redacted change is signed as a set",
      "appId": "demo",
      "dataSet": "main",
      "change": {
        "device": "a",
        "seq": 1,
        "clock": 3,
        "collection": "items",
        "id": "x",
        "kind": "redacted",
        "check": "c1"
      },
      "text": "demo-change:2|{\"check\":\"c1\",\"clock\":3,\"collection\":\"items\",\"device\":\"a\",\"id\":\"x\",\"kind\":\"set\",\"seq\":1,\"set\":\"main\",\"v\":2}"
    },
    {
      "name": "a redacted change keeps its prev: the text equals the one of the original set",
      "appId": "demo",
      "dataSet": "main",
      "change": {
        "device": "a",
        "seq": 2,
        "clock": 5,
        "collection": "items",
        "id": "y",
        "kind": "redacted",
        "check": "c4",
        "prev": "c1"
      },
      "text": "demo-change:2|{\"check\":\"c4\",\"clock\":5,\"collection\":\"items\",\"device\":\"a\",\"id\":\"y\",\"kind\":\"set\",\"prev\":\"c1\",\"seq\":2,\"set\":\"main\",\"v\":2}"
    },
    {
      "name": "the data set and the app are part of the text; non-ASCII stays raw",
      "appId": "other",
