        "prev": "c0"
      },
      "text": "other-change:2|{\"check\":\"c3\",\"clock\":99,\"collection\":\"käse\",\"device\":\"d-1\",\"id\":\"😀\",\"kind\":\"set\",\"prev\":\"c0\",\"seq\":12,\"set\":\"münch\",\"v\":2}"
    }
  ]
}
